{
  "uid": "neond-storage",
  "title": "NeonD \u2014 Storage and recovery",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "neond",
    "alpha"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "NeonD Prometheus",
          "value": "neond-prometheus"
        }
      },
      {
        "name": "deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(alini_health_observed_at, service_namespace)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(alini_slot_reachable{service_namespace=~\"$deployment\"}, alini_node_id)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "slot",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(alini_slot_reachable{service_namespace=~\"$deployment\",alini_node_id=~\"$node\"}, alini_slot_id)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "shard",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(alini_shard_observed{service_namespace=~\"$deployment\",alini_node_id=~\"$node\",alini_slot_id=~\"$slot\"}, alini_shard_id)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "Slot reachable",
      "type": "timeseries",
      "description": "0 means unreachable; no series means telemetry is absent.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "alini_slot_reachable{service_namespace=~\"$deployment\",alini_node_id=~\"$node\",alini_slot_id=~\"$slot\"}",
          "legendFormat": "{{alini_node_id}} / {{alini_slot_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Storage admission",
      "type": "timeseries",
      "description": "0 means admission is blocked. Check available space, local budget and upload progress. Requires per-slot budgets in a distributed deployment; the local bundled image does not emit these series.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "alini_slot_storage_admission{service_namespace=~\"$deployment\",alini_node_id=~\"$node\",alini_slot_id=~\"$slot\"}",
          "legendFormat": "{{alini_node_id}} / {{alini_slot_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Local storage budget used",
      "type": "timeseries",
      "description": "Watch sustained growth and headroom; do not delete unpreserved files. Requires per-slot budgets in a distributed deployment; the local bundled image does not emit these series.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * alini_slot_storage_used{service_namespace=~\"$deployment\",alini_node_id=~\"$node\",alini_slot_id=~\"$slot\"} / alini_slot_storage_budget{service_namespace=~\"$deployment\",alini_node_id=~\"$node\",alini_slot_id=~\"$slot\"}",
          "legendFormat": "{{alini_node_id}} / {{alini_slot_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Disk space available",
      "type": "timeseries",
      "description": "Shared-volume free space can appear on multiple slots. Do not sum it as independent capacity.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "alini_slot_disk_available{service_namespace=~\"$deployment\",alini_node_id=~\"$node\",alini_slot_id=~\"$slot\"}",
          "legendFormat": "{{alini_node_id}} / {{alini_slot_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Remote upload backlog",
      "type": "timeseries",
      "description": "Growing backlog means local data awaits remote preservation. Check S3 availability, credentials and ingress.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "alini_remote_backlog{service_namespace=~\"$deployment\",alini_node_id=~\"$node\",alini_slot_id=~\"$slot\",alini_shard_id=~\"$shard\"}",
          "legendFormat": "{{alini_shard_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Remote upload errors (current snapshot)",
      "type": "timeseries",
      "description": "Snapshot of engine totals, exported as gauges. Do not apply rate() as if these were monotonic OTel counters.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "alini_remote_upload_errors{service_namespace=~\"$deployment\",alini_node_id=~\"$node\",alini_slot_id=~\"$slot\",alini_shard_id=~\"$shard\"}",
          "legendFormat": "{{alini_shard_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Remote fetch errors (current snapshot)",
      "type": "timeseries",
      "description": "Investigate S3 access and replay/recovery logs.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "alini_remote_fetch_errors{service_namespace=~\"$deployment\",alini_node_id=~\"$node\",alini_slot_id=~\"$slot\",alini_shard_id=~\"$shard\"}",
          "legendFormat": "{{alini_shard_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Remote retry attempts (current snapshot)",
      "type": "timeseries",
      "description": "Snapshot totals can reset when a stream restarts or retires.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "alini_remote_retry_attempts{service_namespace=~\"$deployment\",alini_node_id=~\"$node\",alini_slot_id=~\"$slot\",alini_shard_id=~\"$shard\"}",
          "legendFormat": "{{alini_shard_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Subscription pending",
      "type": "timeseries",
      "description": "Backlog across consumers; it can count the same message for several subscribers.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "alini_subscription_pending{service_namespace=~\"$deployment\",alini_node_id=~\"$node\",alini_slot_id=~\"$slot\",alini_shard_id=~\"$shard\"}",
          "legendFormat": "{{alini_shard_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Slot CPU",
      "type": "timeseries",
      "description": "One-core percent; can exceed 100 on a multicore engine.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "alini_slot_process_cpu{service_namespace=~\"$deployment\",alini_node_id=~\"$node\",alini_slot_id=~\"$slot\"}",
          "legendFormat": "{{alini_node_id}} / {{alini_slot_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Archives pending \u2014 deployment-wide",
      "type": "timeseries",
      "description": "Node/slot/shard filters do not apply: archive instruments are deployment-wide.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "neond_archive_pending{service_namespace=~\"$deployment\"}",
          "legendFormat": "{{service_instance_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Oldest pending archive \u2014 deployment-wide",
      "type": "timeseries",
      "description": "Increasing age suggests stuck preservation or cleanup. Read namespace/phase in logs.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "neond_archive_oldest_pending_age{service_namespace=~\"$deployment\"}",
          "legendFormat": "{{service_instance_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 12,
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Archive failures \u2014 deployment-wide",
      "type": "timeseries",
      "description": "Inspect phase and diagnostic logs; automatic retries preserve local data.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase) (rate(neond_archive_failures{service_namespace=~\"$deployment\"}[$__rate_interval]))",
          "legendFormat": "{{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      }
    }
  ]
}
